# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore and will NOT be committed to git.

# Firebase Functions base URL
# - Local dev (emulator):  http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1
# - Production:            https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net
VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1

# Firebase Client SDK (from Firebase Console > Project Settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Kakao JavaScript Key (from Kakao Developers > My Application > App Keys > JavaScript Key)
VITE_KAKAO_JS_KEY=your_kakao_js_key_here

# Google Places API key is NOT stored here.
# Store it as a Firebase Secret (server-side only):
#   firebase secrets:set GOOGLE_PLACES_API_KEY
