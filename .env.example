# Copy this file to .env.local and fill in your values.
# .env.local is in .gitignore and will NOT be committed to git.

# Firebase Functions base URL
# - Local dev (emulator):  http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1
# - Production:            https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net
VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1

# Google Places API key is NOT stored here.
# Store it as a Firebase Secret (server-side only):
#   firebase secrets:set GOOGLE_PLACES_API_KEY
